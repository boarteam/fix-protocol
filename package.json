{
  "name": "@boarteam/fix-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Dictionary-driven FIX protocol toolkit for TypeScript: parse, validate, and encode FIX messages.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.7.3",
      "human-id": "4.1.1"
    }
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "check:bundle": "node scripts/check-bundle.mjs",
    "examples": "node examples/parse-and-validate.mjs && node examples/encode-a-message.mjs && node examples/demo-decode.mjs snapshot && node examples/demo-decode.mjs broken && node examples/fixt-pair.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.2",
    "happy-dom": "^20.11.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
